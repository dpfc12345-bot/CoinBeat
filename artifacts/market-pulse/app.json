{
  "expo": {
    "name": "CoinBeat",
    "slug": "market-pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "market-pulse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080A0B"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.marketpulse.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MarketPrice",
              "label": "CoinBeat 가격",
              "description": "선택한 코인의 실시간 Upbit KRW 가격",
              "minWidth": "160dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "440dp",
              "maxResizeHeight": "440dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "MarketNews",
              "label": "CoinBeat 뉴스",
              "description": "블록미디어 RSS 최신 암호화폐 헤드라인",
              "minWidth": "160dp",
              "minHeight": "150dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "440dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2b7ac132-be80-4bed-8d49-508cabcdc813"
      }
    }
  }
}
